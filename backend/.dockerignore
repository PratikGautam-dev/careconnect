# Backend build context (Dockerfile) -- keeps secrets, local state, and dev
# cruft out of the image and out of Docker's build cache/layers. The build
# context is this backend/ directory itself (see docker-compose.yml's
# `context: ./backend`), so frontend/ and repo-root files are never part of
# it in the first place -- nothing to exclude for those here.
.worktrees

venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
tests/
design-reference/

# Secrets: never baked into the image -- docker-compose.yml passes them at
# runtime via env_file, per this project's own "DATABASE_URL etc. are never
# committed or baked in" rule (see .gitignore).
.env
.env.*
!.env.example

*.log
*.db
pgdata/
local_storage/

# Docs -- irrelevant to what actually runs.
*.md
