# Core -- required for the bot to start
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-match-it-in-metas-dashboard
WHATSAPP_APP_SECRET=your-meta-app-secret
REDIS_URL=redis://localhost:6379

# Local dev Postgres (docker compose up -d) -- NOT the real deployed database.
# The real DATABASE_URL lives in .env.production (gitignored) and must only
# ever be used deliberately, never loaded automatically by local dev commands.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/whatsapp_dev

# Patient document storage (core/storage.py) -- optional. Omit entirely and
# uploads fall back to local disk storage (fine for dev). Works against real
# AWS S3 (omit S3_ENDPOINT_URL) or an S3-compatible store like Cloudflare R2
# (set S3_ENDPOINT_URL to that provider's endpoint).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Internal
INTERNAL_SECRET=choose-a-random-string
ADMIN_SECRET=choose-a-random-string
PORTAL_SECRET=choose-a-random-string
# Gates the platform-wide tenant list/edit pages (/admin/tenants, /admin/edit-tenant)
# separately from ADMIN_SECRET (which only gates onboarding a NEW hospital) --
# deliberately a different value so a leaked onboarding secret can't also be
# used to view/edit every existing tenant's stored credentials.
TENANTS_ADMIN_SECRET=choose-a-different-random-string
# Signs the dedicated doctor-login session token (auth/doctor_session.py) --
# its own value, separate from PORTAL_SECRET/AUTH_SECRET, so a leak of either
# of those can never forge a doctor-scoped token or vice versa.
DOCTOR_SECRET=choose-yet-another-random-string
# RBAC (docs/rbac-redis-plan.md): staff_users JWT access tokens
# (auth/jwt_session.py) and super_admins JWT access tokens -- own, separate
# values from every secret above and from each other, same "a leaked secret
# should only forge the one thing it's for" reasoning DOCTOR_SECRET follows.
JWT_SECRET=choose-a-random-string-for-staff-jwts
SUPER_ADMIN_JWT_SECRET=choose-a-different-random-string-for-super-admin-jwts

# The deployed Next.js frontend's origin, added to CORS. localhost:3000 is
# already allowed for local dev -- only needed once you deploy the frontend.
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Google Meet integration (alongside, not replacing, the existing Jitsi
# tele-consultation link) -- all three optional. Leave every one of these
# genuinely blank/unset until you have real values: the app boots cleanly
# without them and the "Connect Google Calendar" feature just shows an
# "isn't configured yet" message on the doctor-schedule page instead of a
# connect button. A SEPARATE OAuth client from GOOGLE_CLIENT_ID/SECRET above
# (create a second one in Google Cloud Console, Calendar scope only) -- a
# leaked credential for one must never be usable for the other.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Fernet key encrypting stored Calendar access/refresh tokens at rest --
# generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_TOKEN_ENCRYPTION_KEY=
