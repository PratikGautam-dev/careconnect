# Backend build context (Dockerfile) -- keeps secrets, local state, and dev
# cruft out of the image and out of Docker's build cache/layers, and keeps
# the build context small so `docker build` doesn't upload gigabytes of
# unrelated files (frontend/node_modules, .git history, etc.) it will never
# use.
.git
.github
.worktrees

# Frontend has its own Dockerfile/.dockerignore -- never needed in the
# backend image, and node_modules alone would dwarf the actual build context.
frontend/

venv/
__pycache__/
*.pyc
.pytest_cache/
tests/
design-reference/

# Secrets: never baked into the image -- docker-compose.yml passes them at
# runtime via env_file, per this project's own "DATABASE_URL etc. are never
# committed or baked in" rule (see .gitignore).
.env
.env.*
!.env.example

*.log
*.db
pgdata/
local_storage/

# Docs -- irrelevant to what actually runs.
*.md
